# Seguridad Apache
Options -Indexes

# Bloquear acceso directo a carpetas sensibles
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Bloquear acceso a carpetas PHP
    RewriteRule ^php/models/ - [F,L]
    RewriteRule ^php/controllers/ - [F,L]
    RewriteRule ^php/core/ - [F,L]
    
    # Bloquear acceso a archivos de configuración
    RewriteRule ^config/ - [F,L]
    
    # Bloquear acceso a archivos sensibles
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^csv/ - [F,L]
</IfModule>

# Proteger archivos PHP directos
<FilesMatch "\.(php)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Bloquear acceso a archivos de configuración
<FilesMatch "^(config|database|\.env)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

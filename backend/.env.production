# Production Environment Variables
# Estas variables deben configurarse en Railway

# Database Configuration (Railway MySQL)
DB_HOST=${MYSQLHOST}
DB_NAME=${MYSQLDATABASE}
DB_USER=${MYSQLUSER}
DB_PASS=${MYSQLPASSWORD}
DB_PORT=${MYSQLPORT}

# Server
PORT=${PORT}
NODE_ENV=production

# CORS - Actualizar con tu dominio de frontend en Railway
CORS_ORIGIN=${FRONTEND_URL}

# Session Secret - Usar variable de Railway
SESSION_SECRET=${SESSION_SECRET}
